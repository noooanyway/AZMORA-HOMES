# Only supply verified Azmora contact values. All PUBLIC_ values are visible to visitors.
PUBLIC_CONTACT_EMAIL=
PUBLIC_CONTACT_PHONE=
PUBLIC_WHATSAPP=

# Cloudflare build (never put secrets in PUBLIC_ variables).
SITE_URL=https://www.azmorahomes.pt
BASE_PATH=/
CATALOG_MODE=production
# Runtime bindings/secrets are configured in Cloudflare, not here.
# DB, PHOTOS, ADMIN_ORIGIN, ACCESS_ISSUER, ACCESS_AUD, ADMIN_EMAILS
# TURNSTILE_SITE_KEY, TURNSTILE_SECRET_KEY, RESEND_API_KEY
# CONTACT_FROM_EMAIL=notificacoes@send.azmorahomes.pt
# CONTACT_TO_EMAIL=geral@azmorahomes.pt
# CONTACT_TEST_TO_EMAIL= (optional temporary recipient; remove after acceptance)
