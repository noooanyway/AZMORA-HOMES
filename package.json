{
  "name": "azmora-homes",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "catalog:validate": "node scripts/catalog.mjs",
    "catalog:import": "node scripts/catalog.mjs --import",
