    "test:worker": "node tests/inventory-worker.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.5",
    "@astrojs/cloudflare": "^14.4.9",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@fontsource/dm-sans": "^5.2.0",
    "astro": "^7.4.13",
    "jose": "^6.2.18",
    "lucide-astro": "^0.468.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.125.0"
  },
  "devDependencies": {
    "playwright-core": "^1.65.1",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^0.14.1"
  }
}
