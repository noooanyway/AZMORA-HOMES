---
import {
  Armchair, CircleCheck, CircleX, FileText, Handshake, House, MapPin, MessageSquare,
  Plug, ReceiptText, Ship, Shovel, Snowflake, Warehouse,
} from 'lucide-astro';
import LiftIcon from './LiftIcon.astro';
import { url } from '../lib/site';
import '../styles/purchase-guide.css';
const commercial = Astro.locals.siteSettings?.content?.commercial;

const panels = [
  {
    title: 'O que confirmar no orçamento',
    Badge: CircleCheck,
    note: 'Peça a descrição da unidade, do preço e das condições de entrega por escrito.',
    items: [
      { Icon: Warehouse, title: 'Casa móvel em segunda mão', text: 'Confirme a unidade e as características indicadas na ficha e no orçamento.' },
      { Icon: Armchair, title: 'Mobiliário e equipamento', text: 'O mobiliário e os equipamentos apresentados estão incluídos, respeitando a informação específica da unidade.' },
      { Icon: Snowflake, title: 'Climatização e água quente', text: 'Confirme quais os equipamentos existentes e o seu estado.' },
      { Icon: Ship, title: 'Transporte marítimo', text: commercial?.transport ?? 'O preço inclui transporte até ao porto marítimo da ilha de destino nas condições do orçamento, que depende da ilha de destino.' },
      { Icon: ReceiptText, title: 'IVA e valor final', text: commercial?.included ?? 'Os preços incluem IVA; peça o orçamento para a ilha de destino.' },
    ],
  },
  {
    title: 'O que preparar na ilha',
    Badge: CircleX,
    note: 'Confirme responsabilidades e custos antes de organizar a instalação.',
    items: [
      { Icon: MapPin, title: 'Transporte por estrada', text: commercial?.excluded ?? 'O transporte dentro da ilha é da responsabilidade do cliente.' },
      { Icon: LiftIcon, title: 'Colocação no terreno', text: commercial?.delivery ?? 'A descarga e a instalação são da responsabilidade do cliente.' },
      ...(!commercial ? [{ Icon: Shovel, title: 'Preparação do terreno', text: 'A preparação do terreno é da responsabilidade do cliente.' }] : []),
      ...(!commercial ? [{ Icon: Plug, title: 'Ligações às redes', text: 'As ligações são da responsabilidade do cliente.' }] : []),
      { Icon: FileText, title: 'Licenças e autorizações', text: 'Os procedimentos que a Câmara Municipal indicar para instalar e utilizar a casa no terreno.' },
    ],
  },
];
const steps = [
  { Icon: House, title: 'Escolha a casa', text: 'Consulte a ficha e compare as características e o equipamento.' },
  { Icon: MessageSquare, title: 'Peça um orçamento', text: 'Indique a casa e a localidade ou ilha de destino.' },
  { Icon: Handshake, title: 'Confirme as condições', text: commercial?.process ?? 'Peça a disponibilidade e as condições aplicáveis por escrito.' },
  { Icon: Ship, title: 'Combine a entrega', text: 'Confirme o destino, os custos e a organização da entrega.' },
];
---

<section class="section purchase-guide" id="como-funciona" aria-labelledby="purchase-title">
  <div class="purchase-heading">
    <div>
      <p class="kicker"><i></i> ORÇAMENTO E ENTREGA</p>
      <h2 id="purchase-title">O que entra no <em>orçamento?</em></h2>
    </div>
    <p>Peça um orçamento que identifique a casa, o equipamento, os custos e as condições de entrega. Confirme o que precisa de preparar em terra.</p>
  </div>

  <div class="purchase-panels">
    {panels.map(({ title, Badge, note, items }, index) => (
      <section class:list={['purchase-panel', { 'purchase-panel-dark': index === 1 }]}>
        <h3><Badge size={38} strokeWidth={1.5} aria-hidden="true" />{title}</h3>
        <p class="purchase-panel-note">{note}</p>
        <ul role="list">
          {items.map(({ Icon, title, text }) => (
            <li><Icon size={30} strokeWidth={1.6} aria-hidden="true" /><div><strong>{title}</strong><p>{text}</p></div></li>
          ))}
        </ul>
      </section>
    ))}
  </div>

  <section class="purchase-process" aria-labelledby="purchase-process-title">
    <h3 id="purchase-process-title">Como funciona a compra</h3>
    <ol class="purchase-steps">
      {steps.map(({ Icon, title, text }) => (
        <li><Icon size={24} aria-hidden="true" /><h4>{title}</h4><p>{text}</p></li>
      ))}
    </ol>
    {commercial && <><p><strong>Visitas:</strong> {commercial.visits}</p><p><strong>Inspeção:</strong> {commercial.inspection}</p></>}
  </section>

  <div class="purchase-callouts">
    <aside>
      <Ship size={25} aria-hidden="true" />
      <div>
        <h3>Açores e Madeira</h3>
        <p>{commercial?.islands ?? 'A atividade destina-se aos Açores e à Madeira; não realizamos vendas para Portugal continental. Indique a ilha de destino para o orçamento.'}</p>
        <a class="under" href={url('contactos/?motivo=transporte')}>Pedir informação sobre transporte</a>
      </div>
    </aside>
    <aside>
      <MapPin size={25} aria-hidden="true" />
      <div>
        <h3>Antes de preparar o terreno</h3>
        <p>Confirme com a Câmara Municipal se pode instalar a casa no local para o uso pretendido. Valide também os acessos e as ligações.</p>
        <a class="under" href={url('termos/#terreno')}>Ver o que confirmar</a>
      </div>
    </aside>
  </div>
</section>
