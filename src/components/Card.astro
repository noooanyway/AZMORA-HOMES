---
import { Heart, Columns2, BedDouble, Maximize2, Bath } from 'lucide-astro';
import { detail, priceRequest, pageHouses, url } from '../lib/site';
const houses = pageHouses(Astro.locals);
import { bathroomCount, name, status, price, houseMeasure, type House } from '../lib/catalog';
import Photo from './Photo.astro';
const { h, heading: Heading = 'h3' } = Astro.props as { h: House; heading?: 'h2' | 'h3' };
const repeatedModel = h.model && houses.some((unit) => unit.id !== h.id && unit.brand === h.brand && unit.model === h.model);
const title = repeatedModel ? h.name_for_site.replace(/\s+[—-]\s+T\d+$/, '') : name(h);
const area = houseMeasure(h, 'area');
const bathrooms = bathroomCount(h);
const unavailable = ['reservado', 'vendido'].includes(h.availability);
---

<article class="card" data-card={h.media_slug}>
  <div class="card-photo">
    <a href={detail(h)} aria-label={'Ver ' + title}><Photo h={h} /></a>{
      h.typology && <b class="tag">{h.typology}</b>
    }<button
      type="button"
      class="heart"
      data-fav={h.media_slug}
      aria-label={'Guardar ' + title + ' nos favoritos'}
      aria-pressed="false"><Heart size={18} /></button>
  </div><div class="card-body">
    <small class="eyebrow">{h.brand}</small><Heading class="card-title">
      <a href={detail(h)}>{title}</a>
    </Heading><ul class="spec-mini" role="list">
      <li>
        <BedDouble size={15} aria-hidden="true" />
        <span>{h.bedrooms == null ? 'Quartos por confirmar' : `${h.bedrooms} ${h.bedrooms === 1 ? 'quarto' : 'quartos'}`}</span>
      </li>
      <li>
        <Bath size={15} aria-hidden="true" />
        {bathrooms ? <span>{bathrooms} <abbr title="Casas de banho">WC</abbr></span> : <span>WC por confirmar</span>}
      </li>
      <li class="spec-mini-area">
        <Maximize2 size={14} aria-hidden="true" />
        <span>
          {area.value?.replaceAll(' m²', '\u00a0m²') ?? 'Área por confirmar'}
          {area.value && <small>{area.source === 'reference' ? 'De referência' : 'Anunciada'}</small>}
        </span>
      </li>
    </ul><p class="muted card-availability">
      {h.condition && <strong>{h.condition}</strong>}
      <span>{status(h)}</span>
    </p><div class="card-foot">
      <a class="card-price-link" href={unavailable ? url('casas/') : priceRequest(h)} aria-label={unavailable ? 'Ver casas disponíveis' : `${price(h)} Pedir preço e disponibilidade de ${h.name_for_site}`}>
        <strong>{unavailable ? status(h) : price(h)}</strong>
        <span>{unavailable ? 'Ver casas disponíveis' : 'Pedir preço e disponibilidade'}</span>
      </a><button
        data-compare={h.media_slug}
        aria-pressed="false"><Columns2 size={15} />Comparar</button>
    </div>
  </div>
</article>
