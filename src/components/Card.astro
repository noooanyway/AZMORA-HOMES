---
import { Heart, Columns2, BedDouble, Maximize2, Bath } from 'lucide-astro';
import { detail } from '../lib/site';
import { name, status, price, num, type House } from '../lib/catalog';
import Photo from './Photo.astro';
const { h } = Astro.props as { h: House };
---

<article class="card" data-card={h.id}>
  <div class="card-photo">
    <a href={detail(h)} aria-label={'Ver ' + name(h)}><Photo h={h} /></a>{
      h.typology && <b class="tag">{h.typology}</b>
    }<button
      type="button"
      class="heart"
      data-fav={h.id}
      aria-label={'Guardar ' + name(h) + ' nos favoritos'}
      aria-pressed="false"><Heart size={18} /></button>
  </div><div class="card-body">
    <small class="eyebrow">{h.brand} <span> / {h.id.slice(-3)}</span></small><h3
    >
      <a href={detail(h)}>{name(h)}</a>
    </h3><div class="spec-mini">
      {
        h.bedrooms && (
          <span>
            <BedDouble size={15} />
            {h.bedrooms} quartos
          </span>
        )
      }{
        h.bathrooms && (
          <span>
            <Bath size={15} />
            {h.bathrooms} WC
          </span>
        )
      }{
        h.area_m2 && (
          <span>
            <Maximize2 size={14} />
            {num(h.area_m2)} m²
          </span>
        )
      }
    </div><p class="muted">{status(h)}</p><div class="card-foot">
      <strong>{price(h)}</strong><button
        data-compare={h.id}
        aria-pressed="false"><Columns2 size={15} />Comparar</button>
    </div>
  </div>
</article>
