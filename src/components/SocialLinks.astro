---
import { Facebook, Instagram } from 'lucide-astro';
import { getContacts, preview } from '../lib/site';
const contacts = getContacts(Astro.locals);
const { whatsappOnly = false, socialOnly = false } = Astro.props as { whatsappOnly?: boolean; socialOnly?: boolean };
const whatsappUrl = contacts.whatsappHref;
const links = [
  ...(!whatsappOnly ? [
    { label: 'Instagram', href: contacts.social.instagram, Icon: Instagram },
    { label: 'Facebook', href: contacts.social.facebook, Icon: Facebook },
  ] : []),
  ...(!socialOnly ? [{ label: 'WhatsApp', href: whatsappUrl }] : []),
].filter(({ href }) => href || preview);
---

{links.length > 0 && (
  <ul class="social-links" aria-label={whatsappOnly ? 'WhatsApp' : 'Redes sociais'} role="list">
    {links.map(({ label, href, Icon }) => {
      const Tag = href ? 'a' : 'span';
      const isWhatsApp = label === 'WhatsApp';
      return (
        <li>
          <Tag
            id={whatsappOnly && href ? 'whatsapp' : undefined}
            class:list={[whatsappOnly ? 'btn primary' : 'social-icon', { 'social-placeholder': !href }]}
            href={href || undefined}
            target={href ? '_blank' : undefined}
            rel={href ? 'noopener noreferrer' : undefined}
            aria-label={href ? label : `${label} a definir`}
            title={href ? label : `${label} a definir`}
          >
            {isWhatsApp ? (
              <svg viewBox="0 0 24 24" width="21" height="21" fill="currentColor" aria-hidden="true">
                <path d="M12.04 0a11.9 11.9 0 0 0-10.3 17.88L0 24l6.26-1.64A11.94 11.94 0 1 0 12.04 0Zm0 21.85a9.9 9.9 0 0 1-5.05-1.38l-.36-.21-3.72.98.99-3.62-.23-.37a9.93 9.93 0 1 1 8.37 4.6Zm5.45-7.4c-.3-.15-1.77-.87-2.04-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.18.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48a9.1 9.1 0 0 1-1.66-2.07c-.17-.3-.02-.46.13-.61.14-.13.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.08-.79.37-.27.3-1.04 1.02-1.04 2.49 0 1.47 1.07 2.89 1.22 3.09.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.88.12.57-.09 1.77-.73 2.02-1.42.25-.7.25-1.3.17-1.42-.07-.12-.27-.2-.57-.35Z"/>
              </svg>
            ) : Icon && <Icon size={20} aria-hidden="true" />}
            {whatsappOnly && <span>Contactar por WhatsApp</span>}
          </Tag>
        </li>
      );
    })}
  </ul>
)}
{!whatsappOnly && preview && links.some(({ href }) => !href) && (
  <p class="social-note">Ligações a definir</p>
)}
