---
import { company, getContacts, preview } from '../lib/site';
const contacts = getContacts(Astro.locals);
const { mode = 'contact' } = Astro.props as { mode?: 'contact' | 'footer' | 'legal' };
type Field = { label: string; value: string; placeholder: string; href?: string; caption?: string };
const identity: Field[] = [
  { label: 'Denominação legal', value: company.legalName, placeholder: 'Denominação legal a definir' },
  { label: 'NIF / NIPC', value: company.taxId, placeholder: 'NIF / NIPC a definir' },
  { label: 'Registo', value: company.registration, placeholder: 'Dados de registo a definir' },
];
const channels: Field[] = [
  { label: 'Email', value: contacts.email, placeholder: 'Email comercial a definir', href: contacts.email ? 'mailto:' + contacts.email : '' },
  ...(mode === 'contact' ? [] : [{ label: 'Telemóvel', value: contacts.phoneHref ? contacts.phone : '', placeholder: 'Telemóvel comercial a definir', href: contacts.phoneHref, caption: contacts.phoneCaption }]),
  { label: 'Telemóvel', value: contacts.secondPhone, placeholder: '', href: contacts.secondPhone ? 'tel:' + contacts.secondPhone.replace(/[^\d+]/g, '') : '', caption: /^(?:\+351)?9\d{8}$/.test(contacts.secondPhone.replace(/[^\d+]/g, '')) ? 'Chamada para a rede móvel nacional' : '' },
  { label: 'Morada da empresa', value: company.registeredAddress, placeholder: 'Morada da empresa a definir' },
];
const visits: Field[] = [
  { label: 'Horário', value: contacts.openingHours, placeholder: 'Horário de atendimento a definir' },
  { label: 'Idiomas de atendimento', value: contacts.languages, placeholder: '' },
  { label: 'Local de visita', value: company.visitAddress, placeholder: 'Local e condições de visita a definir' },
];
const fields = (mode === 'legal'
  ? [...identity, ...channels]
  : mode === 'contact' ? [...channels, ...visits] : channels)
  .filter((field) => field.value || preview);
---

{fields.length > 0 && (
  <dl class:list={['business-details', `business-details-${mode}`]}>
    {fields.map((field) => (
      <div>
        <dt>{field.label}</dt>
        <dd>
          {field.value
            ? ('href' in field && field.href ? <a href={field.href}>{field.value}</a> : field.value)
            : <span class="business-placeholder">{field.placeholder}</span>}
          {'caption' in field && field.caption && <small>{field.caption}</small>}
        </dd>
      </div>
    ))}
  </dl>
)}
