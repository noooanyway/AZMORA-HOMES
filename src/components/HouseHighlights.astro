---
import { Bath, BedDouble, House as HouseIcon, MoveDiagonal, Ruler, SlidersHorizontal } from 'lucide-astro';
import { bathroomCount, houseMeasure, type House } from '../lib/catalog';

const { h } = Astro.props as { h: House };
const area = houseMeasure(h, 'area');
const length = houseMeasure(h, 'length');
const width = houseMeasure(h, 'width');
const dimensions = length.value && width.value && length.source === width.source
  ? [{ label: length.source === 'reference' ? 'Dimensões (ref.)' : 'Dimensões', value: `${length.value.replace(/ m$/, '')} × ${width.value}`, Icon: Ruler }]
  : [
    { label: length.source === 'reference' ? 'Comprimento (ref.)' : 'Comprimento', value: length.value, Icon: Ruler },
    { label: width.source === 'reference' ? 'Largura (ref.)' : 'Largura', value: width.value, Icon: Ruler },
  ].filter(({ value }) => value != null);
const highlights = [
  { label: 'Tipologia', value: h.typology, Icon: HouseIcon },
  { label: 'Quartos', value: h.bedrooms, Icon: BedDouble },
  { label: area.source === 'reference' ? 'Área de referência' : 'Área anunciada', value: area.value, Icon: MoveDiagonal },
  { label: 'Casas de banho', value: bathroomCount(h), Icon: Bath },
  ...dimensions,
  ...(h.condition ? [{ label: 'Condição', value: h.condition, Icon: SlidersHorizontal }] : []),
];
---

<dl class="house-highlights" aria-label="Características principais">
  {highlights.map(({ label, value, Icon }) => (
    <div>
      <span class="house-spec-icon"><Icon size={20} aria-hidden="true" /></span>
      <dt>{label}</dt>
      <dd class:list={{ 'highlight-pending': value == null }}>
        {typeof value === 'string' ? value.replace(/ (m²?)/gu, ' $1') : value ?? 'Por confirmar'}{label === 'Casas de banho' && h.bathrooms == null && h.bathroom_layout && (
          <sup><a href="#nota-casas-de-banho" aria-label="Nota sobre a configuração do WC">*</a></sup>
        )}
      </dd>
    </div>
  ))}
</dl>
