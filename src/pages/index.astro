---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
import Photo from '../components/Photo.astro';
import PurchaseGuide from '../components/PurchaseGuide.astro';
import { url, detail, pageHouses } from '../lib/site';
const houses = pageHouses(Astro.locals);
import { name } from '../lib/catalog';
import { Search, SlidersHorizontal } from 'lucide-astro';
const brands = [...new Set(houses.map(h => h.brand))].sort();
const hero =
  houses.find((h) => h.featured && h.media.length) ||
  houses.find((h) => h.id.endsWith('-007') && h.media.length) ||
  houses.find((h) => h.media.length);
const types = [...new Set(houses.map((h) => h.typology).filter(Boolean))];
const featured = [
  ...houses.filter((h) => h.media.length),
  ...houses.filter((h) => !h.media.length),
].sort((a,b) => Number(!!b.featured) - Number(!!a.featured)).slice(0, 3);
---

<Layout sharePhoto={hero?.media[0]} description="Explore casas móveis usadas para os Açores e a Madeira. Compare as fichas e peça um orçamento com IVA e entrega no porto da sua ilha." title="Casas móveis usadas para os Açores e a Madeira"
  ><section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="kicker"><i></i> CASAS MÓVEIS EM SEGUNDA MÃO</p><h1>
          Outra forma <br />de <em>habitar.</em>
        </h1><p class="intro">
          Escolha a sua casa móvel em segunda mão. Entregamos no porto comercial da sua ilha, nos Açores ou na Madeira.
        </p><a class="btn cream" href={url('casas/')}>Explorar as casas</a>
      </div>{
        hero ? (
          <figure class="hero-image">
            <>
              <Photo h={hero} hero />
              <figcaption>
                <>
                  <span>EM DESTAQUE</span>
                  <a href={detail(hero)}>
                    {name(hero)} · {hero.typology}
                  </a>
                </>
              </figcaption>
            </>
          </figure>
        ) : (
          <div class="landscape" aria-hidden="true">
            <>
              <div class="sun" />
              <div class="ridges" />
            </>
          </div>
        )
      }
    </div>
  </section><div class="wrap">
    <form class="quick" action={url('casas/')}>
      <div class="quick-title">
        <SlidersHorizontal size={22} /><strong>Encontre a sua casa</strong>
      </div><label
        >Marca<select name="brand"
          ><option value="">Todas</option>{
            brands.map((b) => <option>{b}</option>)
          }</select
        ></label
      ><label
        >Tipologia<select name="typology"
          ><option value="">Todas</option>{
            types.map((t) => <option>{t}</option>)
          }</select
        ></label
      ><button class="btn primary"><Search size={17} />Pesquisar</button>
    </form><section class="section">
      <p class="kicker"><i></i> A NOSSA SELEÇÃO</p><div class="section-heading">
        <h2>Casas em <em>destaque</em></h2><a class="under" href={url('casas/')}
          >Ver catálogo completo</a>
      </div><div class="cards">{featured.map((h) => <Card h={h} />)}</div>{
        !featured.length && (
          <p>Estamos a preparar a próxima seleção de casas.</p>
        )
      }<p class="muted">Preços e disponibilidade sob consulta.</p>
    </section>{
      brands.length > 0 && (
        <div class="brands">
          {brands.map((b) => (
            <a href={url('casas/?brand=' + encodeURIComponent(b))}>{b}</a>
          ))}
        </div>
      )
    }<PurchaseGuide /><section class="section faq">
      <h2>Perguntas frequentes</h2><details>
        <summary>Como confirmo o preço e a disponibilidade?</summary><p>
          Consulte a ficha da unidade e prepare o seu pedido de informação para
          a Azmora Homes.
        </p>
      </details><details>
        <summary>Onde ficam guardadas as minhas favoritas?</summary><p>
          Neste navegador, disponíveis na página Favoritos sem criar conta.
        </p>
      </details><details>
        <summary>Posso instalar uma casa móvel no meu terreno?</summary>
        <p>Antes de reservar ou comprar, confirme com a Câmara Municipal se o terreno admite a instalação para o uso que pretende e quais os procedimentos aplicáveis. Verifique ainda o acesso ao local e as ligações necessárias. <a class="under" href={url('termos/#terreno')}>Ver o que confirmar</a></p>
      </details><a class="under" href={url('contactos/')}
        >Contactar a Azmora Homes</a>
    </section>
  </div></Layout
>
