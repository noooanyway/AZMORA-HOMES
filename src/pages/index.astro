---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
import Photo from '../components/Photo.astro';
import PurchaseGuide from '../components/PurchaseGuide.astro';
import defaults from '../data/site-content.json';
import { faqAnswer } from '../lib/commercial';
import { url, detail, pageHouses } from '../lib/site';
const houses = pageHouses(Astro.locals);
import { name } from '../lib/catalog';
import { Search, SlidersHorizontal } from 'lucide-astro';
const brands = [...new Set(houses.map(h => h.brand))].sort();
const hero =
  houses.find((h) => h.featured && h.media.length) ||
  houses.find((h) => h.id.endsWith('-007') && h.media.length) ||
  houses.find((h) => h.media.length);
const types = [...new Set(houses.map((h) => h.typology).filter(Boolean))];
const content = Astro.locals.siteSettings?.content;
const displayedContent = content || defaults;
const oldDescription = 'Escolha a sua casa móvel em segunda mão para os Açores ou a Madeira. Entregas nos Açores e na Madeira, sujeitas à confirmação das condições de transporte para a ilha de destino. Não realizamos vendas para Portugal continental.';
const introduction = displayedContent.home.description === oldDescription ? defaults.home.description : displayedContent.home.description;
const automaticFeatured = [
  ...houses.filter((h) => h.media.length),
  ...houses.filter((h) => !h.media.length),
].sort((a,b) => Number(!!b.featured) - Number(!!a.featured)).slice(0, 3);
const featured = content?.home.featured.length ? content.home.featured.flatMap(slug => houses.filter(h => h.media_slug === slug)).slice(0,3) : automaticFeatured;
---

<Layout sharePhoto={hero?.media[0]} description="Explore casas móveis usadas para os Açores e a Madeira. Compare as fichas e peça informações sobre preços e entrega." title="Casas móveis usadas para os Açores e a Madeira"
  ><section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="kicker"><i></i> CASAS MÓVEIS EM SEGUNDA MÃO</p><h1>
          {content ? <>{content.home.title}<br /><em>{content.home.subtitle}</em></> : <>Outra forma <br />de <em>habitar.</em></>}
        </h1><p class="intro">
          {introduction}
        </p><a class="btn cream" href={url('casas/')}>Explorar as casas</a>
      </div>{
        hero ? (
          <figure class="hero-image">
            <>
              <Photo h={hero} hero />
              <figcaption>
                <>
                  <span>EM DESTAQUE</span>
                  <a href={detail(hero)}>
                    {name(hero)} · {hero.typology}
                  </a>
                </>
              </figcaption>
            </>
          </figure>
        ) : (
          <div class="landscape" aria-hidden="true">
            <>
              <div class="sun" />
              <div class="ridges" />
            </>
          </div>
        )
      }
    </div>
  </section><div class="wrap">
    <form class="quick" action={url('casas/')}>
      <div class="quick-title">
        <SlidersHorizontal size={22} /><strong>Encontre a sua casa</strong>
      </div><label
        >Marca<select name="brand"
          ><option value="">Todas</option>{
            brands.map((b) => <option>{b}</option>)
          }</select
        ></label
      ><label
        >Tipologia<select name="typology"
          ><option value="">Todas</option>{
            types.map((t) => <option>{t}</option>)
          }</select
        ></label
      ><button class="btn primary"><Search size={17} />Pesquisar</button>
    </form><section class="section">
      <p class="kicker"><i></i> A NOSSA SELEÇÃO</p><div class="section-heading">
        <h2>{content?.home.selectionTitle ?? <>Casas em <em>destaque</em></>}</h2><a class="under" href={url('casas/')}
          >Ver catálogo completo</a>
      </div><div class="cards">{featured.map((h) => <Card h={h} />)}</div>{
        !featured.length && (
          <p>Estamos a preparar a próxima seleção de casas.</p>
        )
      }<p class="muted">Preços e disponibilidade sob consulta.</p>
    </section>{
      brands.length > 0 && (
        <div class="brands">
          {brands.map((b) => (
            <a href={url('casas/?brand=' + encodeURIComponent(b))}>{b}</a>
          ))}
        </div>
      )
    }<PurchaseGuide /><section class="section"><h2>Casas móveis para os Açores e a Madeira</h2><p>{content?.home.regionText ?? 'Explore o catálogo de casas móveis usadas e saiba o que preparar para um pedido de informação para a sua região.'}</p><p><a class="under" href={url('casas-moveis-acores/')}>Casas móveis nos Açores</a> · <a class="under" href={url('casas-moveis-madeira/')}>Casas móveis na Madeira</a> · <a class="under" href={url('guias/como-escolher-casa-movel-usada/')}>Guia para escolher uma casa usada</a></p></section><section class="section faq">
      <h2>Perguntas frequentes</h2>{displayedContent.faq.filter(f => f.visible).map(f => <details><summary>{f.question}</summary><p>{faqAnswer(f, displayedContent.commercial)} {f.question === 'Posso instalar uma casa móvel no meu terreno?' && <a class="under" href={url('termos/#terreno')}>Ver o que confirmar</a>}</p></details>)}<a class="under" href={url('contactos/')}
        >Contactar a Azmora Homes</a>
    </section>
  </div></Layout
>
