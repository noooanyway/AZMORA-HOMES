---
import Layout from '../layouts/Layout.astro';
import CatalogData from '../components/CatalogData.astro';
import Card from '../components/Card.astro';
import { url, pageHouses } from '../lib/site';
const houses = pageHouses(Astro.locals);
---

<Layout noindex title="Favoritos"
  ><CatalogData /><div class="wrap page" id="favorites">
    <p class="kicker"><i></i> A SUA SELEÇÃO</p><h1>
      Casas <em>favoritas.</em>
    </h1><p>As casas que guardou neste navegador.</p><div
      class="cards"
      id="saved"
      hidden
    >
      {houses.map((h) => <Card h={h} heading="h2" />)}
    </div><div class="empty" id="favempty">
      <h2>A sua seleção começa aqui.</h2><p>
        Toque no coração de uma casa para a guardar.
      </p><a class="btn primary" href={url('casas/')}>Explorar casas</a>
    </div><a class="btn primary" id="favcontact" hidden
      >Pedir informações sobre as favoritas</a>
  </div></Layout
>
