---
import Layout from '../../layouts/Layout.astro';
import Photo from '../../components/Photo.astro';
import Card from '../../components/Card.astro';
import CallContact from '../../components/CallContact.astro';
import HouseHighlights from '../../components/HouseHighlights.astro';
import HouseTechnical from '../../components/HouseTechnical.astro';
import '../../styles/house-detail.css';
import { url, detail, priceRequest, pageHouses, houses as staticHouses } from '../../lib/site';
const houses = pageHouses(Astro.locals);
import { price, status, type House } from '../../lib/catalog';
import {
  Heart,
  Columns2,
  Expand,
  X,
  ChevronLeft,
  ChevronRight,
} from 'lucide-astro';
export function getStaticPaths() {
  return staticHouses.map((h) => ({ params: { slug: h.media_slug }, props: { h } }));
}
const h: House | undefined = Astro.props.h ?? houses.find(unit => unit.media_slug === Astro.params.slug);
if (!h) {
  const legacy = houses.find(unit => unit.id === Astro.params.slug);
  if (legacy) return Astro.redirect(detail(legacy), 301);
  return Astro.rewrite(url('404/'));
}
const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    ['Início', url()], ['Casas', url('casas/')], [h.name_for_site, detail(h)],
  ].map(([name, path], index) => ({
    '@type': 'ListItem', position: index + 1, name, item: new URL(path, Astro.site).href,
  })),
};
const related = houses
  .filter((p) => p.id !== h.id)
  .sort((a, b) => Number(b.brand === h.brand) - Number(a.brand === h.brand))
  .slice(0, 3);
---

<Layout
  title={h.seo_title || h.name_for_site}
  sharePhoto={h.media[0]}
  description={h.seo_description || h.description_azmora || undefined}
  ><div class="wrap page">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbs).replace(/</g, '\\u003c')} />
    <nav class="crumb" aria-label="Percurso da página">
      <a href={url()}>Início</a> / <a href={url('casas/')}>Casas</a>
    </nav><p class="kicker"><i></i>{h.brand}{h.typology && ' · ' + h.typology}</p><h1>
      {h.name_for_site}
    </h1><HouseHighlights h={h} /><div class="details">
      <div>
        <div class="main-photo" id="gallery">
          {
            h.media.length ? (
              <button
                class="zoom"
                data-photo="0"
                aria-label={`Ampliar fotografia de ${h.name_for_site}`}
              >
                <>
                  <Photo h={h} hero />
                  <span>
                    <Expand size={17} /> Ampliar
                  </span>
                </>
              </button>
            ) : (
              <Photo h={h} />
            )
          }
        </div>{
          h.media.length > 0 && (
            <div class="thumbs">
              {h.media.map((m, i) => (
                <button
                  data-photo={i}
                  aria-label={`Ampliar fotografia ${i + 1} de ${h.name_for_site}`}
                >
                  <img src={url(m.small || m.src)} alt={m.alt} width={m.width} height={m.height} loading="lazy" />
                </button>
              ))}
            </div>
          )
        }
      </div><aside class="summary">
        <p class="eyebrow">INFORMAÇÃO COMERCIAL</p><h2>{price(h)}</h2><p>
          {status(h)}
        </p><a
          class="btn primary"
          href={priceRequest(h)}>Pedir preço e disponibilidade</a>
        <CallContact />
        <a class="under summary-guide-link" href={url('#como-funciona')}>O que confirmar sobre a entrega</a><div class="actions">
          <button data-fav={h.media_slug}><Heart size={16} />Favoritos</button><button
            data-compare={h.media_slug}><Columns2 size={16} />Comparar</button>
        </div>
      </aside>
    </div><HouseTechnical h={h} />{
      related.length > 0 && (
        <section>
          <>
            <h2>Outras casas</h2>
            <div class="cards">
              {related.map((h) => (
                <Card h={h} />
              ))}
            </div>
          </>
        </section>
      )
    }
  </div>{
    h.media.length > 0 && (
      <dialog
        id="lightbox"
        data-unit={h.media_slug}
        aria-label={`Galeria de ${h.name_for_site}`}
      >
        <script type="application/json" id="gallery-data" set:html={JSON.stringify(h.media.map(({ src, alt }) => ({ src, alt }))).replace(/</g, '\\u003c')} />
        <div>
          <>
            <button class="icon close" data-close aria-label="Fechar galeria">
              <X />
            </button>
            <img id="enlarged" alt="" />
            <div class="actions">
              <>
                <button class="icon" id="prev" aria-label="Fotografia anterior">
                  <ChevronLeft />
                </button>
                <span id="position" aria-live="polite" />
                <button class="icon" id="next" aria-label="Fotografia seguinte">
                  <ChevronRight />
                </button>
              </>
            </div>
          </>
        </div>
      </dialog>
    )
  }</Layout
>
