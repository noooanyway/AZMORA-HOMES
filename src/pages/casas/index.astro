---
import Layout from '../../layouts/Layout.astro';
import Card from '../../components/Card.astro';
import CatalogData from '../../components/CatalogData.astro';
import Filters from '../../components/Filters.astro';
import { pageHouses } from '../../lib/site';
const houses = pageHouses(Astro.locals);
import { Search, SlidersHorizontal, Grid2X2, List, ChevronDown } from 'lucide-astro';
---

<Layout title="Catálogo de casas móveis" description="Pesquise casas móveis usadas por marca, tipologia e quartos. Consulte as fotografias, compare as medidas e peça o preço da unidade."
  ><CatalogData /><div class="wrap page">
    <p class="kicker"><i></i> CATÁLOGO</p><h1>Explore as <em>casas.</em></h1><p
      class="intro"
    >
      Casas móveis em segunda mão para os Açores e a Madeira. Preços e disponibilidade sob consulta.
    </p><section id="catalog">
      <div class="toolbar">
        <label class="search"
          ><Search size={18} /><input
            type="search"
            name="q"
            aria-label="Pesquisar casas"
            placeholder="Pesquisar marca ou modelo"
          /></label
        ><button type="button" class="btn outline" id="filter-toggle"
          aria-controls="filters" aria-expanded="false"
          ><SlidersHorizontal size={16} />Filtros<ChevronDown class="filter-chevron" size={15} /></button
        ><label class="sort"
          ><select aria-label="Ordenar casas" name="sort"
            ><option value="">Ordem do catálogo</option><option value="nome"
              >Nome A–Z</option
            >{
              houses.some((h) => h.area_m2 != null) && (
                <option value="area">Maior área anunciada</option>
              )
            }{
              houses.some((h) => h.public_price_eur != null) && (
                <>
                  <>
                    <option value="preco-asc">Menor preço</option>
                    <option value="preco-desc">Maior preço</option>
                  </>
                </>
              )
            }</select
          ></label
        ><div class="views">
          <button class="icon" data-view="grid" aria-label="Vista em grelha"
            ><Grid2X2 size={18} /></button
          ><button class="icon" data-view="list" aria-label="Vista em lista"
            ><List size={20} /></button>
        </div>
      </div><section id="filters" class="filter-panel" aria-labelledby="filter-heading" hidden>
        <div class="filter-head">
          <h2 id="filter-heading">Filtrar casas</h2>
          <button type="button" class="btn outline" data-reset>Limpar filtros</button>
        </div>
        <form id="filterform">
          <Filters />
        </form>
      </section><div class="result-line">
        <strong id="count" aria-live="polite">{houses.length} casas</strong><div
          id="chips"
        >
        </div>
      </div><div class="cards" id="results">
        {houses.map((h) => <Card h={h} heading="h2" />)}
      </div><div id="empty" class="empty" hidden>
        <h2>Nenhuma casa encontrada</h2><p>
          Experimente outra pesquisa ou retire alguns filtros.
        </p><button class="btn outline" data-reset>Limpar filtros</button>
      </div>
    </section>
  </div></Layout
>
