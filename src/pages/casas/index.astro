---
import Layout from '../../layouts/Layout.astro';
import Card from '../../components/Card.astro';
import Filters from '../../components/Filters.astro';
import { houses } from '../../lib/site';
import { Search, SlidersHorizontal, Grid2X2, List, X } from 'lucide-astro';
---

<Layout title="Catálogo de casas móveis"
  ><div class="wrap page">
    <p class="kicker"><i></i> CATÁLOGO</p><h1>Explore as <em>casas.</em></h1><p
      class="intro"
    >
      Preços e disponibilidade sob consulta.
    </p><section id="catalog">
      <div class="toolbar">
        <label class="search"
          ><Search size={18} /><input
            type="search"
            name="q"
            aria-label="Pesquisar casas"
            placeholder="Pesquisar marca, modelo ou referência"
          /></label
        ><button class="btn outline" data-open="filters"
          ><SlidersHorizontal size={16} />Filtros</button
        ><label class="sort"
          ><select aria-label="Ordenar casas" name="sort"
            ><option value="">Ordem do catálogo</option><option value="nome"
              >Nome A–Z</option
            >{
              houses.some((h) => h.area_m2 != null) && (
                <option value="area">Maior área</option>
              )
            }{
              houses.some((h) => h.public_price_eur != null) && (
                <>
                  <>
                    <option value="preco-asc">Menor preço</option>
                    <option value="preco-desc">Maior preço</option>
                  </>
                </>
              )
            }</select
          ></label
        ><div class="views">
          <button class="icon" data-view="grid" aria-label="Vista em grelha"
            ><Grid2X2 size={18} /></button
          ><button class="icon" data-view="list" aria-label="Vista em lista"
            ><List size={20} /></button>
        </div>
      </div><dialog id="filters">
        <button class="icon close" data-close aria-label="Fechar filtros"
          ><X /></button
        ><h2>Filtrar casas</h2><form id="filterform">
          <Filters /><div class="actions">
            <button type="button" class="btn outline" data-reset>Limpar</button
            ><button class="btn primary">Aplicar filtros</button>
          </div>
        </form>
      </dialog><div class="result-line">
        <strong id="count" aria-live="polite">{houses.length} casas</strong><div
          id="chips"
        >
        </div>
      </div><div class="cards" id="results">
        {houses.map((h) => <Card h={h} />)}
      </div><div id="empty" class="empty" hidden>
        <h2>Nenhuma casa encontrada</h2><p>
          Experimente outra pesquisa ou retire alguns filtros.
        </p><button class="btn outline" data-reset>Limpar filtros</button>
      </div>
    </section>
  </div></Layout
>
