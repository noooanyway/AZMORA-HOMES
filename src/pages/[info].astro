---
import Layout from '../layouts/Layout.astro';
import { url } from '../lib/site';
const pages = {
  sobre: [
    'Sobre a Azmora Homes',
    'Uma escolha com espaço para pensar.',
    'A Azmora Homes é um revendedor independente de casas móveis. Reunimos unidades do catálogo da Exposul para que possa conhecer os modelos, observar as fotografias e comparar as características de cada casa.',
    'Cada ficha representa uma unidade. Duas casas do mesmo modelo podem ter equipamentos e dimensões diferentes. A referência acompanha o seu pedido para identificar exatamente a casa escolhida.',
  ],
  privacidade: [
    'Privacidade',
    'A sua seleção fica consigo.',
    'Os favoritos e a comparação são guardados no armazenamento local deste navegador. Pode removê-los na seleção ou apagando os dados do site nas definições do navegador.',
    'Quando o formulário estiver ativo, os dados que indicar serão enviados ao serviço de contacto configurado pela Azmora para responder ao pedido. A identificação do responsável, os contactos e as condições de tratamento aguardam confirmação antes do lançamento comercial.',
  ],
  termos: [
    'Termos de utilização',
    'Informação sobre o catálogo.',
    'As fichas identificam unidades com base na informação do fornecedor. Preço, disponibilidade, estado, equipamento e condições de venda carecem de confirmação individual pela Azmora Homes.',
    'A seleção ou o envio de um pedido de informação não reserva uma unidade. Os dados empresariais e as condições comerciais serão disponibilizados após validação.',
  ],
};
export function getStaticPaths() {
  return ['sobre', 'privacidade', 'termos'].map((info) => ({
    params: { info },
  }));
}
const [label, title, a, b] = pages[Astro.params.info as keyof typeof pages];
---

<Layout title={label}
  ><div class="wrap page prose">
    <p class="kicker"><i></i>{label}</p><h1>{title}</h1><p class="intro">
      {a}
    </p><p>{b}</p><a href={url('casas/')} class="btn primary">Explorar casas</a>
  </div></Layout
>
