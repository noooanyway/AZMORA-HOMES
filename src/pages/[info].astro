---
import Layout from '../layouts/Layout.astro';
import { url } from '../lib/site';
const pages = {
  sobre: [
    'Sobre a Azmora Homes',
    'Uma escolha com espaço para pensar.',
    'A Azmora Homes é um revendedor independente de casas móveis em segunda mão. Trabalhamos com clientes dos Açores e da Madeira. A Azmora acompanha o pedido desde a escolha da unidade até à entrega no porto comercial da ilha.',
    'Cada ficha representa uma unidade. Duas casas do mesmo modelo podem ter equipamentos e dimensões diferentes. O pedido inclui uma ligação para a ficha da casa escolhida.',
  ],
};
export function getStaticPaths() {
  return ['sobre'].map((info) => ({
    params: { info },
  }));
}
if (Astro.params.info !== 'sobre') return Astro.rewrite(url('404/'));
const [label, title, a, b] = pages[Astro.params.info as keyof typeof pages];
---

<Layout title={label} description={a}
  ><div class="wrap page prose">
    <p class="kicker"><i></i>{label}</p><h1>{title}</h1><p class="intro">
      {a}
    </p><p>{b}</p><a href={url('casas/')} class="btn primary">Explorar casas</a>
  </div></Layout
>
