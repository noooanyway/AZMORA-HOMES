---
import '../styles/theme.css';
import '../styles/site.css';
import '@fontsource-variable/source-serif-4/wght.css';
import '@fontsource-variable/source-serif-4/wght-italic.css';
import '@fontsource/dm-sans/latin-400.css';
import '@fontsource/dm-sans/latin-600.css';
import { Heart, Menu, X, Columns2, Palette } from 'lucide-astro';
import headingFont from '@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-normal.woff2?url';
import bodyFont from '@fontsource/dm-sans/files/dm-sans-latin-400-normal.woff2?url';
import favicon from '../assets/azmora-favicon.png';
import Brand from '../components/Brand.astro';
import CallContact from '../components/CallContact.astro';
import BusinessDetails from '../components/BusinessDetails.astro';
import SocialLinks from '../components/SocialLinks.astro';
import Consent from '../components/Consent.astro';
import { url, preview, complaintsUrl, pageHouses } from '../lib/site';
const houses = pageHouses(Astro.locals);
import { previousCatalogNumber } from '../lib/catalog';
interface Props {
  title: string;
  sharePhoto?: { src: string; alt: string; width: number; height: number };
  description?: string;
  noindex?: boolean;
}
const {
  title,
  noindex = false,
  sharePhoto = houses.find((house) => house.media.length)?.media[0],
  description = 'Descubra e compare casas móveis com a Azmora Homes.',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const nav = [
  ['Casas', 'casas/'],
  ['Como funciona', '#como-funciona'],
  ['Sobre', 'sobre/'],
];
---

<!doctype html>
<html lang="pt-PT">
  <head
    ><meta charset="utf-8" /><meta
      name="viewport"
      content="width=device-width,initial-scale=1"
    />
    <script is:inline>
      (() => {
        const key = 'azmora:theme';
        const system = window.matchMedia('(prefers-color-scheme: dark)');
        const root = document.documentElement;
        let preference;
        try {
          const consent = JSON.parse(localStorage.getItem('azmora:consent-v1') || 'null');
          const saved = consent?.preferences === true ? localStorage.getItem(key) : null;
          if (['light', 'dark', 'gold'].includes(saved)) preference = saved;
        } catch {}

        function apply() {
          root.dataset.theme = preference || (system.matches ? 'dark' : 'light');
          document.querySelectorAll('[data-theme-choice]').forEach((button) => {
            button.setAttribute('aria-pressed', String(button.dataset.themeChoice === (preference || 'system')));
          });
        }

        apply();
        system.addEventListener('change', apply);
        document.addEventListener('DOMContentLoaded', () => {
          apply();
          document.querySelectorAll('[data-theme-choice]').forEach((button) => {
            button.addEventListener('click', () => {
              preference = button.dataset.themeChoice === 'system' ? undefined : button.dataset.themeChoice;
              try {
                const consent = JSON.parse(localStorage.getItem('azmora:consent-v1') || 'null');
                if (consent?.preferences === true && preference) localStorage.setItem(key, preference);
                else localStorage.removeItem(key);
              } catch {}
              apply();
              button.closest('dialog')?.close();
            });
          });
        });
      })();
    </script>
    <link rel="preload" href={headingFont} as="font" type="font/woff2" crossorigin="anonymous" /><link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin="anonymous" /><link rel="icon" href={favicon.src} type="image/png" sizes="64x64" /><title>
      {title} · Azmora Homes
    </title><meta name="description" content={description} /><meta
      name="robots"
      content={noindex || preview || !houses.length ? 'noindex,nofollow' : 'index,follow'}
    />{!noindex && <link rel="canonical" href={canonical} />}<meta
      property="og:title"
      content={title + ' · Azmora Homes'}
    /><meta property="og:description" content={description} /><meta
      property="og:url"
      content={canonical}
    />{sharePhoto && <>
      <meta property="og:image" content={new URL(url(sharePhoto.src), Astro.site)} />
      <meta property="og:image:alt" content={sharePhoto.alt} />
      <meta property="og:image:width" content={String(sharePhoto.width)} />
      <meta property="og:image:height" content={String(sharePhoto.height)} />
    </>}<link rel="sitemap" href={url('sitemap.xml')} /><meta property="og:type" content="website" /><meta
      name="theme-color"
      content="#234237"
    /></head
  ><body data-base={url()}
    ><a class="skip" href="#conteudo">Saltar para o conteúdo</a><header>
      <div class="wrap head">
        <Brand /><nav class="desktop" aria-label="Menu principal">
          {nav.map(([s, p]) => <a href={url(p)}>{s}</a>)}
        </nav><div class="head-actions">
          <CallContact mode="header" />
          <button type="button" class="icon theme-switch" data-open="theme-menu" aria-label="Tema do site"
            aria-haspopup="dialog" aria-controls="theme-menu" aria-expanded="false" title="Tema do site">
            <Palette size={19} aria-hidden="true" />
          </button>
          <a class="favlink" href={url('favoritos/')} aria-label="Favoritos"
            ><Heart size={18} /><span>Favoritos</span><small
              data-fav-count
              hidden></small></a
          ><a class="btn primary top-contact" href={url('contactos/')}
            >Contacte-nos</a
          ><button class="icon mobile" data-open="menu" aria-label="Abrir menu" aria-haspopup="dialog" aria-controls="menu" aria-expanded="false"
            ><Menu /></button>
        </div>
      </div>
    </header><dialog id="menu" aria-label="Menu principal">
      <button class="icon close" aria-label="Fechar menu" data-close
        ><X /></button
      ><nav>
        {
          [
            ...nav,
            ['Favoritos', 'favoritos/'],
            ['Contacte-nos', 'contactos/'],
          ].map(([s, p]) => <a href={url(p)} data-favorites-nav={p === 'favoritos/' ? '' : undefined}>{s}</a>)
        }
      </nav>
    </dialog><dialog id="theme-menu" aria-labelledby="theme-title">
      <button type="button" class="icon close" aria-label="Fechar seletor de tema" data-close><X /></button>
      <h2 id="theme-title">Tema do site</h2>
      <div class="theme-choices">
        {[
          ['light', 'Claro'],
          ['dark', 'Escuro'],
          ['gold', 'Dourado e verde'],
          ['system', 'Usar tema do dispositivo'],
        ].map(([value, label]) => (
          <button type="button" data-theme-choice={value} aria-pressed="false">
            <span class="theme-swatch" aria-hidden="true"></span>{label}
          </button>
        ))}
      </div>
    </dialog><main id="conteudo"><slot /></main><footer class="site-footer">
      <div class="wrap">
        <div class="footer-main">
          <div class="footer-brand"><Brand /></div>
          <div class="footer-contacts">
            <h2>Contactos</h2>
            <BusinessDetails mode="footer" />
          </div>
          <nav class="footer-navigation" aria-label="Navegação do rodapé">
            <h2>Explorar</h2>
            <a href={url('casas/')}>Casas</a>
            <a href={url('casas-moveis-acores/')}>Casas móveis nos Açores</a>
            <a href={url('casas-moveis-madeira/')}>Casas móveis na Madeira</a>
            <a href={url('guias/como-escolher-casa-movel-usada/')}>Guia de compra</a>
            <a href={url('sobre/')}>Sobre</a>
            <a href={url('contactos/')}>Contacte-nos</a>
          </nav>
          <div class="footer-social">
            <h2>Redes sociais</h2>
            <SocialLinks />
          </div>
        </div>
        <div class="footer-bottom">
          <nav aria-label="Informação legal">
            <a href={url('privacidade/')}>Privacidade</a>
            <button type="button" class="consent-footer" data-consent-open>Gerir preferências de privacidade</button>
            <a href={url('termos/')}>Informação legal</a>
            <a href={complaintsUrl}>Livro de Reclamações</a>
          </nav>
        </div>
      </div>
    </footer><Consent /><aside id="tray" hidden>
      <Columns2 size={18} /><span id="traynames"></span><a
        class="btn light"
        id="compareLink"
        href={url('comparar/')}>Comparar</a
      ><button data-clear aria-label="Limpar comparação" class="icon"
        ><X size={17} /></button>
    </aside><div class="notice" role="status" id="notice"></div><script
      type="application/json"
      id="units"
      set:html={JSON.stringify(
        houses.map((h) => ({
          id: h.media_slug,
          name_for_site: h.name_for_site,
          previousNumber: previousCatalogNumber(h.id),
        })),
      ).replace(/</g, '\\u003c')}
    /><script>
      import '../scripts/site';
    </script></body>
</html>
